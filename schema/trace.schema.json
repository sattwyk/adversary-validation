{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "client-action",
              "submit",
              "effect",
              "complete",
              "persist",
              "fault",
              "compete",
              "observe",
              "violation",
              "decision",
              "publication",
              "recover"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "incarnation": {
            "type": "integer",
            "minimum": 0
          },
          "task": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "resource": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "predecessors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "sequence",
          "kind",
          "actor",
          "incarnation",
          "task",
          "operation",
          "resource",
          "predecessors",
          "payload"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "events"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
